/* ---------- brand preloader (Ignite weave) ---------- */
const IG="data:image/png;base64,";
(function(){
  const box=$("#preMark");if(!box)return;
  const N=11;box.style.setProperty("--ig","url("+IG+")");
  let h="";
  for(let i=0;i<N;i++){
    h+=`<i style="--d:${i%2?"-118%":"118%"};background-size:${N*100}% 100%;`+
       `background-position:${(i/(N-1)*100).toFixed(2)}% 0;animation-delay:${(i*52)}ms"></i>`;
  }
  box.innerHTML=h;
  setTimeout(()=>box.classList.add("settle"),60);
  const hide=()=>{const p=$("#pre");if(!p||p.dataset.done)return;p.dataset.done="1";
    p.classList.add("out");setTimeout(()=>p.remove(),700);};
  const reduced=matchMedia("(prefers-reduced-motion:reduce)").matches;
  setTimeout(hide,reduced?250:1750);
  addEventListener("error",hide,true);
})();

