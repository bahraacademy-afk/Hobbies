<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>أكاديمية بحرة | التدريب والتطوير — مجموعة بحرة إلكتريك</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --blue-900:#0b2350;--blue-800:#12326d;--blue-700:#1b4392;--blue-600:#2457b4;--blue-050:#eef3fb;
  --red-600:#c8102e;--red-700:#9d0c23;--gold:#c9a227;--green:#0f8a6a;
  --ink:#0f1c33;--ink-2:#3d4c66;--muted:#65748d;--line:#dfe5ef;--line-2:#eef1f7;
  --page:#fff;--panel:#f6f8fc;--card:#fff;--head:#fff;--topbar:#f2f5fa;
  --r:6px;--maxw:1220px;--fs:16px;--ease:cubic-bezier(.4,0,.2,1);
  --ar:"IBM Plex Sans Arabic","IBM Plex Sans",system-ui,sans-serif;
}
:root[data-theme="dark"],
html[data-theme="dark"]{--ink:#e9eefa;--ink-2:#c2cde3;--muted:#93a2bf;--line:#22304f;--line-2:#1a2743;
  --page:#080f1f;--panel:#0c1526;--card:#0e1830;--head:#0a1326;--topbar:#0a1122;--blue-050:#12203c}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--ink:#e9eefa;--ink-2:#c2cde3;--muted:#93a2bf;
  --line:#22304f;--line-2:#1a2743;--page:#080f1f;--panel:#0c1526;--card:#0e1830;--head:#0a1326;--topbar:#0a1122;--blue-050:#12203c}}
*{box-sizing:border-box}
html{font-size:var(--fs);scroll-behavior:smooth}
body{margin:0;background:var(--page);color:var(--ink);font-family:var(--ar);line-height:1.7;
 -webkit-font-smoothing:antialiased;overflow-x:hidden}
html[dir="ltr"] body{font-family:"IBM Plex Sans","IBM Plex Sans Arabic",sans-serif}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font-family:inherit;font-size:inherit}
button{cursor:pointer}
img{max-width:100%}
svg{flex:none}
:focus-visible{outline:2px solid var(--blue-600);outline-offset:3px}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px}
@media(max-width:600px){.wrap{padding:0 18px}}
.en{display:none}
html[lang="en"] .ar{display:none}
html[lang="en"] .en{display:inline}
html[lang="en"] .en.b{display:block}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

/* ===== motion ===== */
@keyframes rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@keyframes fadein{from{opacity:0}to{opacity:1}}
@keyframes sweep{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes drift{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
.reveal{opacity:0;transform:translateY(26px)}
.reveal.in{animation:rise .62s var(--ease) forwards}
.stg>*{opacity:0}
.stg.in>*{animation:rise .55s var(--ease) forwards}
.stg.in>*:nth-child(2){animation-delay:.08s}
.stg.in>*:nth-child(3){animation-delay:.16s}
.stg.in>*:nth-child(4){animation-delay:.24s}
.stg.in>*:nth-child(5){animation-delay:.32s}
.stg.in>*:nth-child(6){animation-delay:.4s}
html.no-motion *,@media (prefers-reduced-motion:reduce){}
html.no-motion *{animation:none!important;transition:none!important;scroll-behavior:auto!important}
html.no-motion .reveal,html.no-motion .stg>*{opacity:1!important;transform:none!important}
@media (prefers-reduced-motion:reduce){
  .reveal,.stg>*{opacity:1!important;transform:none!important;animation:none!important}
  html{scroll-behavior:auto}
}

/* ===== topbar / header ===== */
.skip{position:fixed;inset-block-start:-70px;inset-inline-start:14px;background:var(--blue-800);color:#fff;
 padding:10px 18px;border-radius:0 0 var(--r) var(--r);z-index:400;transition:.2s}
.skip:focus{inset-block-start:0}
.topbar{background:var(--topbar);border-bottom:1px solid var(--line);font-size:.8125rem;color:var(--ink-2)}
.topbar .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:40px}
.accred{display:flex;align-items:center;gap:9px}
.tlinks{display:flex;gap:20px}
.tlinks a:hover{color:var(--blue-600)}
@media(max-width:820px){.tlinks{display:none}.topbar .wrap{justify-content:center;text-align:center}}
.header{position:sticky;top:0;z-index:90;background:var(--head);border-bottom:1px solid var(--line);transition:box-shadow .25s}
.header.stuck{box-shadow:0 10px 30px -22px rgba(11,35,80,.55)}
.header .wrap{display:flex;align-items:stretch;gap:16px;height:82px}
.brand{display:flex;align-items:center;gap:14px;flex:none}
.brand .mark{height:54px;width:54px;transition:transform .35s var(--ease)}
.brand:hover .mark{transform:rotate(-8deg) scale(1.05)}
.brand .sep{width:1px;background:var(--line);margin:18px 0}
.brand .word{height:26px}
nav.main{display:flex;margin-inline-start:auto}
nav.main a{display:flex;align-items:center;padding:0 17px;font-size:.9375rem;font-weight:500;position:relative;
 border-bottom:3px solid transparent;transition:.18s var(--ease);white-space:nowrap}
nav.main a::after{content:"";position:absolute;inset-inline:17px;bottom:-1px;height:3px;background:var(--red-600);
 transform:scaleX(0);transform-origin:center;transition:transform .26s var(--ease)}
nav.main a:hover{color:var(--blue-600)}
nav.main a:hover::after{transform:scaleX(1)}
nav.main a.active{color:#fff;background:var(--blue-800)}
nav.main a.active::after{transform:scaleX(1);inset-inline:0}
.hact{display:flex;align-items:center;gap:8px;flex:none;margin-inline-start:8px}
.hbtn{width:38px;height:38px;display:grid;place-items:center;border:1px solid var(--line);background:transparent;
 color:var(--ink-2);border-radius:var(--r);transition:.18s}
.hbtn:hover{border-color:var(--blue-600);color:var(--blue-600);transform:translateY(-1px)}
.hbtn .lang{font-size:.75rem;font-weight:600}
.cta{display:inline-flex;align-items:center;gap:8px;background:var(--red-600);color:#fff;border:0;padding:0 20px;
 height:38px;border-radius:var(--r);font-weight:600;font-size:.875rem;transition:.2s var(--ease);position:relative;overflow:hidden}
.cta:hover{background:var(--red-700);transform:translateY(-1px);box-shadow:0 10px 22px -12px var(--red-600)}
#menuBtn{display:none}
@media(max-width:1120px){
 nav.main{position:fixed;inset-block-start:122px;inset-inline:0;flex-direction:column;background:var(--head);
  border-bottom:1px solid var(--line);max-height:0;overflow:hidden;transition:max-height .3s var(--ease);
  box-shadow:0 20px 40px -28px rgba(11,35,80,.5)}
 nav.main.open{max-height:460px}
 nav.main a{padding:15px 28px;border-bottom:1px solid var(--line-2);border-inline-start:3px solid transparent}
 nav.main a::after{display:none}
 nav.main a.active{border-inline-start-color:var(--red-600)}
 #menuBtn{display:grid}
}
@media(max-width:620px){.cta span{display:none}.cta{padding:0 12px}.header .wrap{height:72px}
 nav.main{inset-block-start:112px}.brand .sep,.brand .word{display:none}}

/* ===== hero ===== */
.hero{position:relative;background:#0a1a38;color:#fff;overflow:hidden;border-bottom:3px solid var(--red-600)}
.hero .tile,.phero .tile{position:absolute;inset:0;background:
 repeating-linear-gradient(90deg,transparent 0 238px,rgba(255,255,255,.055) 238px 240px),
 repeating-linear-gradient(0deg,transparent 0 198px,rgba(255,255,255,.05) 198px 200px),
 linear-gradient(115deg,#16243f,#0d1a35 45%,#08132a)}
.chev{position:absolute;inset-block:0;inset-inline-end:-6%;width:62%;opacity:.5}
.chev path{stroke-dasharray:1200;stroke-dashoffset:1200;animation:draw 2.4s var(--ease) forwards}
@keyframes draw{to{stroke-dashoffset:0}}
html.no-motion .chev path{stroke-dashoffset:0;animation:none}
.hero .wrap{position:relative;z-index:3;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:40px;
 min-height:540px;padding-block:52px}
.hero .copy{order:2}
.hero .copy>*{opacity:0;animation:rise .7s var(--ease) forwards}
.hero .copy>*:nth-child(2){animation-delay:.12s}
.hero .copy>*:nth-child(3){animation-delay:.22s}
.hero .copy>*:nth-child(4){animation-delay:.32s}
html.no-motion .hero .copy>*{opacity:1;animation:none}
.kick{display:inline-block;font-size:.8125rem;font-weight:600;color:#a9c0ee;padding-inline-start:14px;
 border-inline-start:3px solid var(--red-600);margin-bottom:20px}
.hero h1{font-size:clamp(2rem,4vw,3.3rem);line-height:1.22;margin:0 0 20px;font-weight:600;letter-spacing:-.01em}
.hero p.lead{font-size:1.0625rem;color:#c2d0ea;max-width:52ch;margin:0 0 30px}
.actions{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;padding:13px 26px;border-radius:var(--r);
 font-weight:600;font-size:.9375rem;transition:.2s var(--ease)}
.btn-p{background:var(--red-600);color:#fff}
.btn-p:hover{background:var(--red-700);transform:translateY(-2px);box-shadow:0 14px 26px -14px var(--red-600)}
.btn-s{background:var(--blue-800);color:#fff}
.btn-s:hover{background:var(--blue-700);transform:translateY(-2px)}
.btn-o{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.45)}
.btn-o:hover{background:rgba(255,255,255,.12)}
.btn-g{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn-g:hover{border-color:var(--blue-600);color:var(--blue-600)}
.sheet{order:1;display:grid;place-items:center;animation:drift 7s ease-in-out infinite}
html.no-motion .sheet{animation:none}
.sheet svg{width:100%;max-width:520px;filter:drop-shadow(0 40px 60px rgba(0,0,0,.55))}
@media(max-width:920px){.hero .wrap{grid-template-columns:1fr;min-height:auto;padding-block:40px}
 .hero .copy{order:1}.sheet{order:2}.sheet svg{max-width:360px}.chev{inset-inline-end:-30%;width:110%;opacity:.28}}

/* ===== figures ===== */
.figures{background:var(--panel);border-bottom:1px solid var(--line)}
.figures .wrap{display:grid;grid-template-columns:repeat(4,1fr)}
.fig{padding:30px 26px;border-inline-start:1px solid var(--line)}
.fig:first-child{border-inline-start:0}
.fig .n{font-size:2rem;font-weight:600;color:var(--blue-700);line-height:1.1;font-feature-settings:"tnum"}
.fig .l{font-size:.875rem;color:var(--muted);margin-top:4px}
@media(max-width:820px){.figures .wrap{grid-template-columns:1fr 1fr}
 .fig:nth-child(3){border-inline-start:0}.fig:nth-child(n+3){border-top:1px solid var(--line)}}

/* ===== sections ===== */
.sec{padding:66px 0}
.sec.alt{background:var(--panel);border-block:1px solid var(--line)}
.shead{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:32px;flex-wrap:wrap}
.shead h2{margin:0;font-size:clamp(1.5rem,2.5vw,2rem);font-weight:600}
.shead .sub{color:var(--muted);font-size:.9375rem;margin:6px 0 0}
.rule{height:3px;width:52px;background:var(--red-600);margin-bottom:14px;transform-origin:inline-start;
 animation:sweep .7s var(--ease) both}
.more{display:inline-flex;align-items:center;gap:7px;font-size:.875rem;font-weight:600;color:var(--blue-700);
 border:1px solid var(--line);padding:9px 18px;border-radius:var(--r);transition:.2s}
.more:hover{background:var(--blue-800);color:#fff;border-color:var(--blue-800)}

/* ===== program cards ===== */
.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
@media(max-width:980px){.pgrid{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.pgrid{grid-template-columns:1fr}}
.pcard{background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;
 flex-direction:column;transition:transform .28s var(--ease),box-shadow .28s var(--ease),border-color .2s}
.pcard:hover{transform:translateY(-6px);border-color:var(--blue-600);box-shadow:0 26px 46px -28px rgba(11,35,80,.6)}
.plate{aspect-ratio:16/9;position:relative;background:#0e1f3f;overflow:hidden}
.plate img,.plate svg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
 transition:transform .5s var(--ease)}
.pcard:hover .plate img{transform:scale(1.06)}
.plate::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,19,42,0) 40%,rgba(8,19,42,.72))}
.trk{position:absolute;inset-block-start:12px;inset-inline-start:12px;z-index:3;background:rgba(255,255,255,.95);
 color:var(--blue-900);font-size:.75rem;font-weight:600;padding:4px 11px;border-radius:3px}
.plate .pid{position:absolute;inset-block-end:12px;inset-inline-start:14px;z-index:3;color:#fff;font-size:.75rem;
 letter-spacing:.06em;opacity:.9;direction:ltr}
.pbody{padding:20px 20px 0;flex:1;display:flex;flex-direction:column}
.pbody h3{margin:0 0 12px;font-size:1.0625rem;font-weight:600;line-height:1.5}
.meta{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}
.mi{display:inline-flex;align-items:center;gap:6px;font-size:.75rem;color:var(--ink-2);border:1px solid var(--line);
 padding:4px 10px;border-radius:3px;background:var(--panel)}
.pbody p{margin:0 0 18px;font-size:.875rem;color:var(--muted);flex:1}
.pfoot{padding:0 20px 20px;display:flex;gap:10px}
.pfoot .btn{padding:10px 18px;font-size:.875rem;flex:1}
.seatbar{height:4px;background:var(--line-2);border-radius:3px;overflow:hidden;margin-bottom:14px}
.seatbar i{display:block;height:100%;background:var(--blue-600);border-radius:3px;transition:width 1s var(--ease)}
.seatline{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted);margin-bottom:6px}

/* ===== search/filters ===== */
.searchrow{display:flex;gap:10px;margin-bottom:24px}
.ib{flex:1;position:relative;display:flex;align-items:center}
.ib svg{position:absolute;inset-inline-start:14px;color:var(--muted)}
.ib input{width:100%;padding:14px 16px;padding-inline-start:44px;border:1px solid var(--line);border-radius:var(--r);
 background:var(--card);color:var(--ink);transition:.2s}
.ib input:focus{outline:none;border-color:var(--blue-600);box-shadow:0 0 0 3px rgba(36,87,180,.14)}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px;border-bottom:1px solid var(--line);padding-bottom:18px}
.chip{border:1px solid var(--line);background:var(--card);color:var(--ink-2);padding:8px 16px;border-radius:3px;
 font-size:.8125rem;font-weight:500;transition:.2s}
.chip:hover{border-color:var(--blue-600);color:var(--blue-600)}
.chip.on{background:var(--blue-800);color:#fff;border-color:var(--blue-800)}
.pager{display:flex;gap:6px;justify-content:center;margin-top:34px}
.pager button{width:38px;height:38px;border:1px solid var(--line);background:var(--card);color:var(--ink-2);
 border-radius:3px;font-weight:600;font-size:.875rem;transition:.2s}
.pager button.on{background:var(--blue-800);color:#fff;border-color:var(--blue-800)}
.pager button:disabled{opacity:.4;cursor:default}
.empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:60px 20px;border:1px dashed var(--line);border-radius:var(--r)}

/* ===== page hero ===== */
.phero{position:relative;background:#0a1a38;color:#fff;overflow:hidden;border-bottom:3px solid var(--red-600)}
.phero .wrap{position:relative;z-index:3;padding-block:56px}
.crumb{font-size:.8125rem;color:#a9c0ee;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.phero h1{margin:0;font-size:clamp(1.75rem,3.4vw,2.75rem);font-weight:600;animation:rise .6s var(--ease) both}
.phero .pd{margin:12px 0 0;color:#c2d0ea;max-width:64ch}

/* ===== about ===== */
.sidelayout{display:grid;grid-template-columns:270px 1fr;gap:34px;align-items:start}
@media(max-width:860px){.sidelayout{grid-template-columns:1fr}}
.sidenav{border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:var(--card);position:sticky;top:100px}
@media(max-width:860px){.sidenav{position:static}}
.sidenav button{display:flex;align-items:center;gap:10px;width:100%;text-align:start;padding:14px 18px;background:transparent;
 border:0;border-bottom:1px solid var(--line-2);color:var(--ink-2);font-size:.9375rem;font-weight:500;transition:.2s}
.sidenav button:last-child{border-bottom:0}
.sidenav button:hover{background:var(--blue-050);color:var(--blue-700)}
.sidenav button.on{background:var(--blue-050);color:var(--blue-800);font-weight:600;box-shadow:inset 3px 0 0 var(--red-600)}
html[dir="ltr"] .sidenav button.on{box-shadow:inset -3px 0 0 var(--red-600)}
.panel{border:1px solid var(--line);border-radius:var(--r);background:var(--card);padding:32px}
.panel h2{margin:0 0 10px;font-size:1.375rem;font-weight:600}
.panel h3{margin:28px 0 10px;font-size:1.0625rem;font-weight:600}
.panel p{color:var(--ink-2);margin:0 0 14px;max-width:74ch;white-space:pre-line}
.vm{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:22px}
@media(max-width:720px){.vm{grid-template-columns:1fr}}
.vbox{border:1px solid var(--line);border-inline-start:3px solid var(--blue-700);border-radius:var(--r);padding:22px;background:var(--panel)}
.vbox+.vbox{border-inline-start-color:var(--red-600)}
.vbox .hd{display:flex;align-items:center;gap:10px;margin-bottom:8px;font-weight:600;color:var(--blue-700)}
.vbox p{margin:0;font-size:.9375rem;color:var(--ink-2)}
.goals{border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.goal{display:flex;gap:18px;padding:20px 22px;border-bottom:1px solid var(--line-2);background:var(--card);transition:.2s}
.goal:last-child{border-bottom:0}
.goal:hover{background:var(--blue-050)}
.goal .n{flex:none;width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--line);border-radius:3px;
 font-weight:600;color:var(--blue-700);font-size:.875rem;background:var(--panel)}
.goal h4{margin:0 0 4px;font-size:1rem;font-weight:600}
.goal p{margin:0;color:var(--muted);font-size:.875rem}
.org .lvl{display:flex;justify-content:center;gap:16px;flex-wrap:wrap}
.org .node{border:1px solid var(--line);border-radius:var(--r);padding:14px 20px;text-align:center;background:var(--card);min-width:190px}
.org .node.top{background:var(--blue-800);color:#fff;border-color:var(--blue-800)}
.org .node b{display:block;font-size:.9375rem}
.org .node span{font-size:.8125rem;opacity:.8}
.org .stem{width:1px;height:26px;background:var(--line);margin:0 auto}
.plist{border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.prow{display:flex;gap:14px;padding:18px 20px;border-bottom:1px solid var(--line-2)}
.prow:last-child{border-bottom:0}
.prow svg{color:var(--blue-700);margin-top:3px}
.prow b{display:block;font-size:.9375rem;margin-bottom:2px}
.prow span{font-size:.875rem;color:var(--muted)}

/* ===== news / reports / team / contact ===== */
.ngrid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
@media(max-width:980px){.ngrid{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.ngrid{grid-template-columns:1fr}}
.ncard{border:1px solid var(--line);border-radius:var(--r);background:var(--card);padding:24px;display:flex;
 flex-direction:column;transition:.26s var(--ease)}
.ncard:hover{transform:translateY(-4px);box-shadow:0 22px 40px -28px rgba(11,35,80,.55);border-color:var(--blue-600)}
.ncard h3{margin:0 0 10px;font-size:1rem;font-weight:600;line-height:1.55}
.ncard p{margin:0 0 18px;font-size:.875rem;color:var(--muted);flex:1}
.nf{display:flex;align-items:center;justify-content:space-between;gap:10px;border-top:1px solid var(--line-2);padding-top:14px}
.date{font-size:.75rem;color:var(--muted);border:1px solid var(--line);padding:3px 10px;border-radius:3px}
.tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
@media(max-width:920px){.tgrid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.tgrid{grid-template-columns:1fr}}
.tcard{border:1px solid var(--line);border-radius:var(--r);background:var(--card);padding:26px;display:flex;gap:16px;transition:.26s}
.tcard:hover{transform:translateY(-4px);box-shadow:0 22px 40px -28px rgba(11,35,80,.5)}
.tcard .av{flex:none;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:600;
 font-size:1.125rem;background:var(--blue-800)}
.tcard h4{margin:0 0 3px;font-size:1rem;font-weight:600}
.tcard .role{color:var(--blue-700);font-size:.8125rem;font-weight:600;margin-bottom:8px}
.tcard .desc{font-size:.8125rem;color:var(--muted);margin-bottom:12px}
