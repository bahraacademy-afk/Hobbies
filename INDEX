async function handleImg(file,w){
  if(!/^image\//.test(file.type)){toast(EN()?"Choose an image file.":"اختر ملف صورة.");return;}
  const box=$("#prevBox");box.innerHTML=`<div class="imgprev" style="display:grid;place-items:center"><span class="spin" style="border-color:var(--line);border-top-color:var(--blue-600)"></span></div>`;
  const small=await shrink(file,1280,.82);
  let done=false;
  try{const r=await API.uploadImage(small,"program.jpg");
    if(r){ if(r.id){w.img=r.id;delete w.imgUrl;} else {w.imgUrl=r.url;delete w.img;}
      delete w.imgData;box.innerHTML=`<img class="imgprev" src="${r.url}">`;done=true;
      toast(EN()?"Image uploaded.":"تم رفع الصورة.");}}catch(e){}
  if(!done){ const tiny=await shrink(file,900,.62),url=await toDataURL(tiny);
    if(url.length>200000){toast(EN()?"Image too large — try a smaller one.":"الصورة كبيرة — جرّب صورة أصغر.");box.innerHTML="";return;}
    w.imgData=url;delete w.img;box.innerHTML=`<img class="imgprev" src="${url}">`;}
}
function shrink(file,max,qual){return new Promise(res=>{
  const img=new Image(),u=URL.createObjectURL(file);
  img.onload=()=>{const s=Math.min(1,max/img.width),c=document.createElement("canvas");
    c.width=Math.round(img.width*s);c.height=Math.round(img.height*s);
    c.getContext("2d").drawImage(img,0,0,c.width,c.height);URL.revokeObjectURL(u);
    c.toBlob(b=>res(b||file),"image/jpeg",qual);};
  img.onerror=()=>res(file);img.src=u;});}
function toDataURL(blob){return new Promise(r=>{const f=new FileReader();f.onload=()=>r(f.result);f.readAsDataURL(blob)})}

