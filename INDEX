const CFG=Object.assign({MODE:"auto",SCRIPT_URL:"",ADMIN_TOKEN:""},window.BLA_CONFIG||{});
function lget(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return d}}
function lset(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
let dbP,asP;
async function DB(){if(dbP===undefined)dbP=(window.claude&&claude.use)?claude.use("db").catch(()=>null):Promise.resolve(null);return dbP;}
async function AS(){if(asP===undefined)asP=(window.claude&&claude.use)?claude.use("assets").catch(()=>null):Promise.resolve(null);return asP;}
const MODE=CFG.MODE!=="auto"?CFG.MODE:((window.claude&&claude.use)?"artifact":(CFG.SCRIPT_URL?"gas":"local"));

/* --- Google Apps Script transport (text/plain avoids a CORS preflight) --- */
async function gas(action,payload){
  const r=await fetch(CFG.SCRIPT_URL,{method:"POST",redirect:"follow",
    headers:{"Content-Type":"text/plain;charset=utf-8"},
    body:JSON.stringify({action,payload:payload||{},token:CFG.ADMIN_TOKEN||""})});
  const j=await r.json();
  if(!j||j.ok!==true)throw new Error((j&&j.error)||"server error");
  return j.data;
}

const API={
  mode:MODE,
  live(){return MODE==="artifact"},
  /* ---- site content + programs ---- */
  async load(){
    if(MODE==="gas"){const d=await gas("getAll");return {content:d.content||null,programs:(d.programs&&d.programs.length)?d.programs:null};}
    if(MODE==="artifact"){
      const db=await DB();if(!db)return null;
      let content=null,programs=null;
      try{const s=await db.doc("content/site").get();if(s.exists&&s.data()&&s.data().data)content=s.data().data;}catch(e){}
      try{const s=await db.collection("programs").get();const r=s.docs.map(d=>d.data());if(r.length)programs=r;}catch(e){}
      return {content,programs};
    }
    return {content:lget("bla_content",null),programs:lget("bla_programs",null)};
  },
  async saveContent(c){
    lset("bla_content",c);
    if(MODE==="gas")return gas("saveContent",{content:c});
    if(MODE==="artifact"){const db=await DB();if(db)return db.doc("content/site").set({data:c,updatedAt:new Date().toISOString()});}
  },
  async saveProgram(p){
    lset("bla_programs",P);
    if(MODE==="gas")return gas("saveProgram",{program:p});
    if(MODE==="artifact"){const db=await DB();if(db)return db.collection("programs").doc(p.id).set(p);}
  },
  async deleteProgram(id){
    lset("bla_programs",P);
    if(MODE==="gas")return gas("deleteProgram",{id});
    if(MODE==="artifact"){const db=await DB();if(db)return db.collection("programs").doc(id).delete();}
  },
  async seedPrograms(list){
    if(MODE==="gas")return gas("seedPrograms",{programs:list});
    if(MODE==="artifact"){const db=await DB();if(!db)return;for(const p of list)await db.collection("programs").doc(p.id).set(p);}
    else lset("bla_programs",list);
  },
  /* ---- enrollment requests ---- */
  async addReg(rec){
    if(MODE==="gas")return gas("addReg",{reg:rec});
    if(MODE==="artifact"){const db=await DB();if(db)return db.collection("registrations").doc(rec.ref).set(rec);}
    const a=lget("bla_regs",[]);a.push(rec);lset("bla_regs",a);
  },
  async listRegs(){
    if(MODE==="gas")return (await gas("listRegs"))||[];
    if(MODE==="artifact"){const db=await DB();if(db){const s=await db.collection("registrations").orderBy("createdAt","desc").get();return s.docs.map(d=>d.data());}}
    return lget("bla_regs",[]).slice().reverse();
  },
  async setRegStatus(ref,status){
    if(MODE==="gas")return gas("setRegStatus",{ref,status});
    if(MODE==="artifact"){const db=await DB();if(db)return db.collection("registrations").doc(ref).update({status});}
    const a=lget("bla_regs",[]);const r=a.find(x=>x.ref===ref);if(r){r.status=status;lset("bla_regs",a);}
  },
  async deleteReg(ref){
    lset("bla_regs",lget("bla_regs",[]).filter(r=>r.ref!==ref));
    if(MODE==="gas")return gas("deleteReg",{ref});
    if(MODE==="artifact"){const db=await DB();if(db)return db.collection("registrations").doc(ref).delete();}
  },
  async addMessage(m){
    if(MODE==="gas")return gas("addMessage",{msg:m});
    if(MODE==="artifact"){const db=await DB();if(db)return db.collection("messages").doc("M"+Date.now()).set(m);}
  },
  /* ---- images ---- */
  async uploadImage(blob,name){
    if(MODE==="gas"){
      const data=await toDataURL(blob);
      const res=await gas("uploadImage",{name:name||("program-"+Date.now()+".jpg"),data});
      return {url:res.url};
    }
    if(MODE==="artifact"){
      const as=await AS();if(!as)return null;
      const r=await as.upload(blob,{type:"image/jpeg"});return {id:r.id,url:r.url};
    }
    return null;
  }
};

async function boot(){
  try{
    const d=await API.load();
    if(d){ if(d.content)C=Object.assign(clone(DEF_CONTENT),d.content);
           if(d.programs)P=d.programs; }
  }catch(e){ console.warn("load failed",e); }
  renderSite();
