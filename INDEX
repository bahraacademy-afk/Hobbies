function toast(m){const e=$("#toast");e.textContent=m;e.classList.add("show");clearTimeout(e._t);e._t=setTimeout(()=>e.classList.remove("show"),3000);}
function ini(n){const p=String(n).trim().split(/\s+/);return (p[0]||"")[0]+((p[1]||"")[0]||"");}
function nl2br(s){return esc(s).replace(/\n/g,"<br>");}
function getPath(o,p){return p.split(".").reduce((a,k)=>a==null?a:a[k],o);}
function setPath(o,p,v){const k=p.split(".");const last=k.pop();let t=o;k.forEach(x=>{if(t[x]==null)t[x]=/^\d+$/.test(x)?[]:{};t=t[x];});t[last]=v;}

